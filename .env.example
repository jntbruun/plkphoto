# Resend — get a key at resend.com
RESEND_API_KEY=re_xxxxxxxxxxxx

# Email address that receives contact form submissions
CONTACT_TO_EMAIL=petter@example.com

# Full URL of the site (no trailing slash)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Plausible domain — set when live domain is confirmed
# PLAUSIBLE_DOMAIN=plkphoto.no

# ─── Admin (Petter's content management UI) ───────────────────────────
# Comma-separated list of email addresses allowed to log in
ALLOWED_ADMIN_EMAILS=petter@example.com,jonathan@example.com

# Sender address for magic-link emails (must be a verified Resend domain)
ADMIN_MAGIC_LINK_FROM=admin@plkphoto.no

# Two distinct 32-byte hex secrets — generate with: openssl rand -hex 32
ADMIN_SESSION_SECRET=replace_with_32_byte_hex
ADMIN_MAGIC_LINK_SECRET=replace_with_different_32_byte_hex

# GitHub fine-grained PAT with Contents: Read & Write on this repo
GITHUB_TOKEN=github_pat_xxxxxxxxxxxx
GITHUB_REPO=jntbruun/plkphoto
GITHUB_BRANCH=main
