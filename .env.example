# Resend — get a key at resend.com (used for the public contact form)
RESEND_API_KEY=re_xxxxxxxxxxxx

# Email address that receives contact form submissions
CONTACT_TO_EMAIL=petter@example.com

# Full URL of the site (no trailing slash)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Plausible domain — set when live domain is confirmed
# PLAUSIBLE_DOMAIN=plkphoto.no

# ─── Admin (Supabase) ─────────────────────────────────────────────────
# Public — exposed to the browser
NEXT_PUBLIC_SUPABASE_URL=https://muctqlzktclvroyuiftp.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Server-only — bypasses RLS, used for admin writes from API routes.
# Get it at: dashboard → project → Settings → API → service_role
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Comma-separated list of email addresses allowed to access /admin.
# Anyone else who logs in is rejected at the API layer.
ALLOWED_ADMIN_EMAILS=petter@example.com,jonathan@example.com
